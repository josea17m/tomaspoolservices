---
import Layout from "../layouts/Layout.astro";
import Services from "../sections/Services.astro";
import Gallery from "../sections/Gallery.astro";
import Contact from "../sections/Contact.astro";
import Presentation from "../sections/Presentation.astro";
import TrustBar from "../sections/TrustBar.astro";
import WhyUs from "../sections/WhyUs.astro";
import Testimonials from "../sections/Testimonials.astro";
---

<Layout>
  <Presentation />
  <TrustBar />
  <main class="px-6 md:px-[5rem] xl:px-[8rem] pt-10 flex flex-col w-full">
    <Services />
    <WhyUs />
    <Testimonials />
    <Gallery />
    <Contact />
  </main>
</Layout>
