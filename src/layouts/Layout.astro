---
import Navbar from "../components/Navbar.astro";
import Footer from "../sections/Footer.astro";
---

<html lang="en">
  <head>
    <meta
      name="keywords"
      content="Pool, Services, Maintenance, Cleaning, Pool Service, Houston, Richmond, Acid wash, Drain, Filter, Repair, Pool repair"
    />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="description" content="Tomas Pool Services" />

    <meta name="author" content="Alex Montero" />
    <meta name="theme-color" content="#1765CE" />
    <meta name="viewport" content="width=device-width" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Tomas Pool Services</title>
  </head>
  <body>
    <Navbar />

    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
    scroll-behavior: smooth;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
    outline: none;
  }
</style>
