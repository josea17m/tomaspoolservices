<section id="contact-us" class="grid grid-cols-1 lg:grid-cols-2 gap-10">
  <form action="https://formspree.io/f/xjvnwzaw" method="POST"
    class="rounded-3xl border shadow-lg p-5 flex flex-col justify-between">
    <input type="text"
      data-en="Name*" data-es="Nombre*" placeholder="Name*"
      required name="name"
      class="w-full border border-gray-300 focus:bg-[#eeeeee7e] rounded-md p-3 mt-5 duration-150" />
    <input type="email"
      data-en="Email*" data-es="Email*" placeholder="Email*"
      required name="email"
      class="w-full border border-gray-300 focus:bg-[#eeeeee7e] rounded-md p-3 mt-5 duration-150" />
    <input type="number"
      data-en="Phone number" data-es="Número de teléfono" placeholder="Phone number"
      name="number"
      class="w-full border border-gray-300 focus:bg-[#eeeeee7e] rounded-md p-3 mt-5 duration-150" />
    <textarea
      data-en="Message" data-es="Mensaje" placeholder="Message"
      cols="30" rows="10" name="message"
      class="w-full border border-gray-300 focus:bg-[#eeeeee7e] rounded-md p-3 mt-5 duration-150"></textarea>
    <input type="submit"
      data-en="Send Message" data-es="Enviar Mensaje" value="Send Message"
      class="w-full font-semibold bg-[#1765CE] cursor-pointer hover:bg-[#0f4fa8] text-white p-3 mt-5 rounded-2xl duration-200" />
  </form>

  <article class="lg:grid row-start-1 lg:row-start-auto flex flex-col lg:grid-cols-2 gap-10">
    <div class="col-span-2 flex flex-col gap-5">
      <h2 class="text-3xl md:text-5xl text-[#1765CE] text-left">
        <span class="en">Get in touch with us</span><span class="es">Contáctanos</span>
      </h2>
      <p class="text-xl text-left">
        <span class="en">We are here to help you with any questions or concerns. Feel free to contact us at any time.</span>
        <span class="es">Estamos aquí para ayudarte con cualquier pregunta. No dudes en contactarnos en cualquier momento.</span>
      </p>
    </div>

    <div class="border flex flex-col justify-between rounded-2xl p-5 shadow-lg text-sm">
      <div class="flex justify-between border-b pb-1"><span class="en">Monday</span><span class="es">Lunes</span><p class="font-semibold text-xs">7am - 6pm</p></div>
      <div class="flex justify-between border-b pt-3 pb-1"><span class="en">Tuesday</span><span class="es">Martes</span><p class="font-semibold text-xs">7am - 6pm</p></div>
      <div class="flex justify-between border-b pt-3 pb-1"><span class="en">Wednesday</span><span class="es">Miércoles</span><p class="font-semibold text-xs">7am - 6pm</p></div>
      <div class="flex justify-between border-b pt-3 pb-1"><span class="en">Thursday</span><span class="es">Jueves</span><p class="font-semibold text-xs">7am - 6pm</p></div>
      <div class="flex justify-between border-b pt-3 pb-1"><span class="en">Friday</span><span class="es">Viernes</span><p class="font-semibold text-xs">7am - 6pm</p></div>
      <div class="flex justify-between border-b pt-3 pb-1"><span class="en">Saturday</span><span class="es">Sábado</span><p class="font-semibold text-xs">7am - 6pm</p></div>
      <div class="flex justify-between border-b pt-3 pb-1"><span class="en">Sunday</span><span class="es">Domingo</span><p class="font-semibold text-xs">7am - 6pm</p></div>
    </div>

    <div class="flex flex-col justify-start gap-4">
      <div class="border rounded-2xl pl-5 py-3 flex flex-col justify-center gap-5 shadow-lg text-sm">
        <p class="text-xl text-[#1765CE]">
          <span class="en">Contact Info</span><span class="es">Información de Contacto</span>
        </p>
        <p>
          <span class="text-[#1765CE] font-medium en">Phone:</span>
          <span class="text-[#1765CE] font-medium es">Teléfono:</span>
          <a class="underline" href="tel:+18328905890">+1 (832) 890-5890</a>
          <span class="text-xs text-[#1765CE] font-medium en"> · Click to call</span>
          <span class="text-xs text-[#1765CE] font-medium es"> · Clic para llamar</span>
        </p>
        <p>
          <span class="text-[#1765CE] font-medium">Email:</span> info@splashguardpool.com
        </p>
      </div>
    </div>

    <div class="col-span-2">
      <a href="https://wa.me/+18328905890" target="_blank"
        class="py-3 text-center w-full md:w-3/4 rounded-2xl text-[#1765CE] border text-xl hover:border-[#1765CE] duration-200 hover:scale-105 flex items-center justify-evenly border-gray-300 hover:shadow-md shadow-sm">
        <span class="en">Chat with us on WhatsApp</span>
        <span class="es">Chatea con nosotros por WhatsApp</span>
        <img class="w-[40px] h-[40px]" src="/whatsapp.webp" alt="whatsapp-logo" />
      </a>
    </div>
  </article>
</section>
